#!/usr/bin/env bash
set -euo pipefail

# Transparent sudo compatibility layer. It makes ordinary `sudo command`
# invoke the local askpass flow without requiring the caller to remember -A.
# Explicit non-interactive/stdin modes remain untouched.

readonly real_sudo="/usr/bin/sudo"
# The helper installed by scripts/doorman-install-askpass (SPEC.md §6.13)
# is a root-owned, setgid `doorman-askpass` binary (mode 2755) at a fixed path
# outside the plugin's checkout. Its identity is its effective gid, which the
# kernel records at connect() and the broker reads via SO_PEERCRED. The socket
# ACL (askpass.sock is group doorman-askpass, 0660) plus the broker's egid gate
# mean a non-setgid substitute connects without that egid and is rejected.
# The installed binary ignores the environment for its socket path: it uses the
# fixed /run/doorman/askpass.sock, and the broker derives the displayed command
# from the real sudo parent's cmdline (§6.12), so none is passed here.
# DOORMAN_ASKPASS is a dev/test override only (e.g. a wrapper running the
# Python broker.askpass, which needs DOORMAN_SOCKET set by the caller). Being
# non-setgid, it is rejected by the production broker, which is correct.
readonly askpass="${DOORMAN_ASKPASS:-/usr/local/lib/omarchy-doorman/doorman-askpass}"

for arg in "$@"; do
  case "$arg" in
    -A|--askpass|-S|--stdin|-n|--non-interactive)
      exec "$real_sudo" "$@"
      ;;
    --*)
      # A long option not in the explicit list above. Checked separately from
      # the short-cluster pattern below: that pattern matches any of A/S/n
      # ANYWHERE in the argument, which would otherwise misfire on long
      # options that merely contain one of those letters, e.g. --preserve-env
      # (contains "n") — silently skipping Doorman for an unrelated flag.
      ;;
    -*[ASn]*)
      exec "$real_sudo" "$@"
      ;;
  esac
done

case "${1:-}" in
  -h|--help|-V|--version)
    exec "$real_sudo" "$@"
    ;;
esac

[[ -x "$askpass" || -f "$askpass" ]] || {
  echo "doorman: askpass helper not installed at $askpass — run" \
       "'sudo scripts/doorman-install-askpass' once first" >&2
  exit 1
}

export SUDO_ASKPASS="$askpass"
# PYTHONPATH is only needed by a Python dev askpass, never the installed binary.
if [[ -n "${DOORMAN_ASKPASS:-}" ]]; then
  plugin_dir="${DOORMAN_PLUGIN_DIR:-${HOME}/.config/omarchy/plugins/mauricio.doorman}"
  export PYTHONPATH="${plugin_dir}${PYTHONPATH:+:${PYTHONPATH}}"
fi

exec "$real_sudo" -A "$@"
