#!/usr/bin/env bash
set -euo pipefail

# Transparent sudo compatibility layer. It makes ordinary `sudo command`
# invoke the local askpass flow without requiring the caller to remember -A.
# Explicit non-interactive/stdin modes remain untouched.

readonly real_sudo="/usr/bin/sudo"
readonly runtime_dir="${XDG_RUNTIME_DIR:?}/omarchy-doorman"
readonly plugin_dir="${DOORMAN_PLUGIN_DIR:-${HOME}/.config/omarchy/plugins/mauricio.doorman}"
# The identity-pinned helper installed by scripts/doorman-install-askpass
# (SPEC.md §6.11) — deliberately a fixed path outside the plugin's own git
# checkout, owned root:root, mode 0711 (execute-only for this user) plus the
# cap_dac_read_search file capability (needed to read its own executable
# content; mode 0711 alone blocks that too). It hands the broker a file
# descriptor for its own executable over the request socket (SCM_RIGHTS),
# which the broker fstat()s to confirm it's genuinely this binary.
# DOORMAN_ASKPASS stays available as an override for development/testing
# against the plain Python askpass.py, which the broker will reject on the
# production path (no matching identity fd).
readonly askpass="${DOORMAN_ASKPASS:-/usr/local/lib/omarchy-doorman/doorman-askpass}"

for arg in "$@"; do
  case "$arg" in
    -A|--askpass|-S|--stdin|-n|--non-interactive)
      exec "$real_sudo" "$@"
      ;;
    --*)
      # A long option not in the explicit list above. Checked separately from
      # the short-cluster pattern below: that pattern matches any of A/S/n
      # ANYWHERE in the argument, which would otherwise misfire on long
      # options that merely contain one of those letters, e.g. --preserve-env
      # (contains "n") — silently skipping Doorman for an unrelated flag.
      ;;
    -*[ASn]*)
      exec "$real_sudo" "$@"
      ;;
  esac
done

case "${1:-}" in
  -h|--help|-V|--version)
    exec "$real_sudo" "$@"
    ;;
esac

[[ -x "$askpass" || -f "$askpass" ]] || {
  echo "doorman: askpass helper not installed at $askpass — run" \
       "'sudo scripts/doorman-install-askpass' once first" >&2
  exit 1
}

export SUDO_ASKPASS="$askpass"
export DOORMAN_SOCKET="${DOORMAN_SOCKET:-${runtime_dir}/broker.sock}"
export DOORMAN_COMMAND="sudo $*"
export PYTHONPATH="${plugin_dir}${PYTHONPATH:+:${PYTHONPATH}}"

exec "$real_sudo" -A "$@"
