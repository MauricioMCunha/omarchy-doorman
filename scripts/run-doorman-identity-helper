#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:?}/omarchy-doorman-identity-helper"
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$runtime_dir"
cd "$project_dir"
exec /usr/bin/python3 -m identity_helper.identity_helper \
  --socket "$runtime_dir/helper.sock"
