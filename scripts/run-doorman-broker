#!/usr/bin/env bash
set -euo pipefail

# Broker runner, executed by the system unit (packaging/omarchy-doorman.service)
# as user `doorman`. No secrets are generated or read: authentication is by
# socket ACL (doorman-askpass / doorman-ui groups) plus the broker's own
# /proc checks. Sockets live in /run/doorman, created by the unit's
# RuntimeDirectory=.

readonly runtime_dir="/run/doorman"
readonly project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# Early existence check only: the broker resolves the gid itself via getgrnam
# (passing --trusted-askpass-gid would trip the test seam in production).
if ! getent group doorman-askpass >/dev/null; then
  echo "run-doorman-broker: group doorman-askpass not found (run doorman-install-askpass)" >&2
  exit 1
fi

# Single owner uid: explicit DOORMAN_OWNER_UID, else the sole login member of
# doorman-ui (the service user `doorman` is also a member, so it is excluded).
owner_uid="${DOORMAN_OWNER_UID:-}"
if [[ -z "$owner_uid" ]]; then
  members="$(getent group doorman-ui | cut -d: -f4 | tr ',' '\n' | grep -v -x -e '' -e doorman || true)"
  if [[ -z "$members" || "$(wc -l <<<"$members")" -ne 1 ]]; then
    echo "run-doorman-broker: doorman-ui must have exactly one login member (found: ${members:-none}); set DOORMAN_OWNER_UID to override" >&2
    exit 1
  fi
  owner_uid="$(id -u -- "$members")"
fi

umask 007
export PYTHONDONTWRITEBYTECODE=1
cd "$project_dir"
exec /usr/bin/python3 -m broker.broker \
  --socket "$runtime_dir/askpass.sock" \
  --control-socket "$runtime_dir/control.sock" \
  --owner-uid "$owner_uid" \
  --timeout 30
