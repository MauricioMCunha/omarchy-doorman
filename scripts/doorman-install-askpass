#!/usr/bin/env bash
set -euo pipefail

# One-time, root-privileged install step for Doorman's system service and its
# setgid askpass helper. Safe to re-run (idempotent), e.g. after
# `omarchy plugin update`. Everything privileged lives OUTSIDE the plugin
# checkout (askpass binary, broker code and runner in /usr/local/lib, unit in
# /etc/systemd/system), so a user-level `git pull` can never rewrite it and
# the system user `doorman` never needs to read the /home checkout.
#
# Trust model: the askpass binary is installed root:doorman-askpass with the
# setgid bit (2755), so its effective gid is `doorman-askpass`; the broker
# verifies that gid on the askpass socket. The broker runs as system user
# `doorman` and exposes a control socket to the `doorman-ui` group.
#
# Usage:   sudo scripts/doorman-install-askpass            # install
#          sudo scripts/doorman-install-askpass --uninstall # teardown

readonly svc_user="doorman"
readonly askpass_group="doorman-askpass"
readonly ui_group="doorman-ui"
readonly unit_name="omarchy-doorman.service"
readonly unit_dest="/etc/systemd/system/${unit_name}"
readonly install_dir="/usr/local/lib/omarchy-doorman"
readonly binary_path="${install_dir}/doorman-askpass"
readonly project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly source_path="${project_dir}/askpass/doorman-askpass.c"
readonly broker_files=(__init__.py broker.py)
readonly runner_rel="scripts/run-doorman-broker"
readonly unit_src="${project_dir}/packaging/${unit_name}"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "doorman-install-askpass: must be run as root (sudo $0)" >&2
  exit 1
fi

login_user="${SUDO_USER:-}"

uninstall() {
  systemctl disable --now "$unit_name" 2>/dev/null || true
  rm -f -- "$unit_dest"
  systemctl daemon-reload
  rm -f -- "$binary_path"
  rm -rf -- "${install_dir}/broker" "${install_dir}/scripts"
  rmdir --ignore-fail-on-non-empty "$install_dir" 2>/dev/null || true
  if [[ -n "$login_user" ]] && id -u "$login_user" >/dev/null 2>&1; then
    gpasswd -d "$login_user" "$ui_group" 2>/dev/null || true
  fi
  if getent passwd "$svc_user" >/dev/null; then userdel "$svc_user" || true; fi
  for g in "$askpass_group" "$ui_group"; do
    if getent group "$g" >/dev/null; then
      # groupdel refuses if it is some user's primary group; tolerate that.
      groupdel "$g" || echo "doorman-install-askpass: group $g left in place (still in use)" >&2
    fi
  done
  echo "doorman-install-askpass: uninstalled. Log out/in to drop stale group membership."
}

if [[ "${1:-}" == "--uninstall" ]]; then
  uninstall
  exit 0
fi

if [[ ! -f "$source_path" ]]; then
  echo "doorman-install-askpass: source not found at $source_path" >&2
  exit 1
fi
if [[ ! -f "$unit_src" ]]; then
  echo "doorman-install-askpass: unit not found at $unit_src" >&2
  exit 1
fi

# --- users and groups -------------------------------------------------------
getent group "$askpass_group" >/dev/null || groupadd --system "$askpass_group"
getent group "$ui_group" >/dev/null || groupadd --system "$ui_group"
if ! getent passwd "$svc_user" >/dev/null; then
  useradd --system --no-create-home --home-dir /nonexistent \
    --shell /usr/bin/nologin --user-group "$svc_user"
fi
# The service user must belong to both groups so it can chgrp both sockets.
usermod -aG "${askpass_group},${ui_group}" "$svc_user"

if [[ -n "$login_user" && "$login_user" != "root" ]]; then
  usermod -aG "$ui_group" "$login_user"
  echo "doorman-install-askpass: added $login_user to $ui_group."
  echo "doorman-install-askpass: NOTE: log out and back in for the group membership to take effect."
else
  echo "doorman-install-askpass: WARNING: SUDO_USER unset; add the login user to $ui_group manually:" >&2
  echo "  usermod -aG $ui_group <user>" >&2
fi

# --- askpass binary (setgid) ------------------------------------------------
mkdir -p "$install_dir"
chown root:root "$install_dir"
chmod 0755 "$install_dir"

tmp_binary="$(mktemp "${install_dir}/.doorman-askpass.XXXXXX")"
trap 'rm -f -- "$tmp_binary"' EXIT

cc -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
  -fstack-protector-strong -D_FORTIFY_SOURCE=2 \
  -o "$tmp_binary" "$source_path"

chown "root:${askpass_group}" "$tmp_binary"
chmod 2755 "$tmp_binary"
mv -f -- "$tmp_binary" "$binary_path"
trap - EXIT

# Verify ownership and the setgid bit stuck (e.g. not stripped by a nosuid fs).
if [[ "$(stat -c '%U:%G' -- "$binary_path")" != "root:${askpass_group}" ]]; then
  echo "doorman-install-askpass: FAILED: $binary_path is not owned by root:${askpass_group}" >&2
  exit 1
fi
if [[ "$(( 0$(stat -c '%a' -- "$binary_path") & 02000 ))" -eq 0 ]]; then
  echo "doorman-install-askpass: FAILED: setgid bit missing on $binary_path" >&2
  exit 1
fi
echo "doorman-install-askpass: installed $binary_path ($(stat -c '%U:%G %a' -- "$binary_path"))"

# --- broker code + runner (root-owned system copy) --------------------------
# The service runs from here, never from the /home checkout. Only the broker's
# runtime modules are copied (stdlib-only); client/bridge/askpass.py/ui_test.py
# are user-side or dev-only and stay in the checkout.
install -d -m 0755 -o root -g root "${install_dir}/broker" "${install_dir}/scripts"
for f in "${broker_files[@]}"; do
  [[ -f "${project_dir}/broker/${f}" ]] || { echo "doorman-install-askpass: missing broker/${f}" >&2; exit 1; }
  install -m 0644 -o root -g root "${project_dir}/broker/${f}" "${install_dir}/broker/${f}"
done
install -m 0755 -o root -g root "${project_dir}/${runner_rel}" "${install_dir}/${runner_rel}"
echo "doorman-install-askpass: installed broker code + runner under $install_dir"

# --- system unit ------------------------------------------------------------
sed "s|@PROJECT_DIR@|${install_dir}|g" "$unit_src" > "$unit_dest"
chown root:root "$unit_dest"
chmod 0644 "$unit_dest"
systemctl daemon-reload
echo "doorman-install-askpass: installed $unit_dest"
echo "doorman-install-askpass: done. Start the broker with:"
echo "  sudo systemctl enable --now ${unit_name}"
echo "doorman-install-askpass: (after a plugin update: sudo systemctl restart ${unit_name})"
